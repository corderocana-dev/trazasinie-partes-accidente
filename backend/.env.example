# Copia este archivo como .env y pon tus datos.

# Conexión a PostgreSQL: postgres://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE_DE_DATOS
# (la base de datos se crea sola con: npm run db:crear)
DATABASE_URL=postgres://postgres:TU_CONTRASEÑA@localhost:5432/trazasinie_db

# Clave secreta para firmar los tokens de sesión (JWT). Pon una larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=8h

PORT=3001
CLIENT_URL=http://localhost:5173
